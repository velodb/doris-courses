{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Doris multilingual content contract 2.0.0",
  "$ref": "#/definitions/package",
  "definitions": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-]+(?:[./][A-Za-z0-9_-]+)*$(?![\\s\\S])",
          "maxLength": 500
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ]
    },
    "module_key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "course_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])",
          "maxLength": 100
        },
        "module_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])",
          "maxLength": 100
        }
      },
      "required": [
        "course_slug",
        "module_id"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "course_slug": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "module_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "course_slug",
        "module_id"
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "json-pointer",
            "notebook-cell",
            "markdown-block"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])",
          "maxLength": 200
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "source_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-]+(?:[./][A-Za-z0-9_-]+)*$(?![\\s\\S])",
          "maxLength": 500
        },
        "locator": {
          "$ref": "#/definitions/locator"
        },
        "source_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "scope",
        "source_path",
        "locator",
        "source_text",
        "source_hash"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "current-session-llm",
            "technical-validator",
            "native-human"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "record": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "target_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "method",
        "actor",
        "record",
        "source_hash",
        "target_hash"
      ]
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])",
          "maxLength": 200
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "target_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "target_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "state": {
          "enum": [
            "translated",
            "llm_checked",
            "reviewed",
            "withdrawn"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "translator": {
              "const": "current-session-llm"
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "batch_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "glossary_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "translator",
            "session_id",
            "batch_id",
            "glossary_version"
          ]
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "llm_self_check": {
              "anyOf": [
                {
                  "$ref": "#/definitions/review"
                },
                {
                  "type": "null"
                }
              ]
            },
            "technical_admission": {
              "anyOf": [
                {
                  "$ref": "#/definitions/review"
                },
                {
                  "type": "null"
                }
              ]
            },
            "native_review": {
              "anyOf": [
                {
                  "$ref": "#/definitions/review"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "llm_self_check",
            "technical_admission",
            "native_review"
          ]
        }
      },
      "required": [
        "unit_id",
        "source_hash",
        "target_text",
        "target_hash",
        "state",
        "provenance",
        "checks"
      ]
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$(?![\\s\\S])",
          "maxLength": 40
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/translation"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "locale",
        "units"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])",
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "lesson",
            "notebook",
            "quiz",
            "ui",
            "image",
            "code",
            "data",
            "metadata"
          ]
        },
        "locale": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$(?![\\s\\S])",
              "maxLength": 40
            },
            {
              "const": "shared"
            }
          ]
        },
        "file": {
          "$ref": "#/definitions/file"
        },
        "source_asset_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "locale",
        "file",
        "source_asset_hash"
      ]
    },
    "question_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$(?![\\s\\S])"
        },
        "type": {
          "const": "single_choice"
        },
        "option_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$(?![\\s\\S])"
          },
          "minItems": 2,
          "maxItems": 100,
          "uniqueItems": true
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "type",
        "option_ids",
        "answer"
      ]
    },
    "quiz_presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$(?![\\s\\S])",
          "maxLength": 40
        },
        "presentation_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])",
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        }
      },
      "required": [
        "locale",
        "presentation_revision",
        "unit_ids"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])",
          "maxLength": 100
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/module_key"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])",
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])",
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "quiz_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])",
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "modules",
        "unit_ids",
        "asset_ids",
        "quiz_ids"
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$(?![\\s\\S])",
          "maxLength": 40
        },
        "publication_state": {
          "enum": [
            "draft",
            "published",
            "withdrawn"
          ]
        }
      },
      "required": [
        "locale",
        "publication_state"
      ]
    },
    "course_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])",
          "maxLength": 100
        },
        "manifest": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-]+(?:[./][A-Za-z0-9_-]+)*$(?![\\s\\S])",
          "maxLength": 500
        },
        "policy_revision": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])",
          "maxLength": 200
        }
      },
      "required": [
        "slug",
        "manifest",
        "policy_revision"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
        },
        "source_schema_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "registry_version": {
          "const": "1.0.0"
        },
        "registry_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "builder_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/file"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "translation_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "teaching_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "package_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "source_ref",
        "source_schema_digest",
        "contract_digest",
        "registry_version",
        "registry_digest",
        "builder_version",
        "files",
        "translation_digest",
        "teaching_digest",
        "package_digest"
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "contract_version": {
          "const": "2.0.0"
        },
        "kind": {
          "const": "doris-content-package"
        },
        "package_state": {
          "enum": [
            "preview",
            "release"
          ]
        },
        "catalog": {
          "const": "catalog.yaml"
        },
        "courses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/course_binding"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/variant"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "default_locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$(?![\\s\\S])",
          "maxLength": 40
        },
        "available_locales": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$(?![\\s\\S])",
            "maxLength": 40
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "locale_digests": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/profile"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "selected_profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])",
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "source_units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/unit"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "translations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/overlay"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/asset"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "quizzes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/quiz"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "snapshot": {
          "$ref": "#/definitions/snapshot"
        },
        "purpose": {
          "enum": [
            "teaching",
            "contract-fixture"
          ]
        }
      },
      "required": [
        "schema_version",
        "contract_version",
        "kind",
        "package_state",
        "catalog",
        "courses",
        "variants",
        "default_locale",
        "available_locales",
        "locale_digests",
        "profiles",
        "selected_profiles",
        "source_units",
        "translations",
        "assets",
        "quizzes",
        "snapshot",
        "purpose"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "courses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "required_courses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "title",
              "required_courses"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "title",
        "description",
        "courses",
        "programs"
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "published",
            "planned",
            "retired"
          ]
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "course": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "lab": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "quiz": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "required": {
          "type": "boolean"
        },
        "requirements": {
          "type": "array",
          "items": {
            "enum": [
              "course_read",
              "lab_opened",
              "lab_declared_complete",
              "quiz_passed"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
              },
              "quiz": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
              }
            },
            "required": [
              "title",
              "path"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "slug",
        "level",
        "order",
        "title",
        "summary",
        "status",
        "estimated_minutes",
        "required",
        "requirements"
      ]
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "short_title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "preview",
