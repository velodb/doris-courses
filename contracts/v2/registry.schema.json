{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_version": {
      "const": "1.0.0"
    },
    "source_locale": {
      "const": "en"
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$(?![\\s\\S])",
            "maxLength": 40
          },
          "route_key": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$(?![\\s\\S])",
            "maxLength": 40
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$(?![\\s\\S])",
              "maxLength": 40
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          },
          "script": {
            "type": "string",
            "pattern": "^[A-Z][a-z]{3}$(?![\\s\\S])"
          },
          "dir": {
            "enum": [
              "ltr",
              "rtl"
            ]
          },
          "format_locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$(?![\\s\\S])",
            "maxLength": 40
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "audience": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "tag",
          "route_key",
          "aliases",
          "script",
          "dir",
          "format_locale",
          "display_name",
          "audience"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "registry_version",
    "source_locale",
    "locales"
  ]
}
