{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://velodb.io/contracts/courses/v1/schema.json",
  "title": "Apache Doris course content contract v1",
  "definitions": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "courses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "required_courses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "title",
              "required_courses"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "title",
        "description",
        "courses",
        "programs"
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "published",
            "planned",
            "retired"
          ]
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "course": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "lab": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "quiz": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "required": {
          "type": "boolean"
        },
        "requirements": {
          "type": "array",
          "items": {
            "enum": [
              "course_read",
              "lab_opened",
              "lab_declared_complete",
              "quiz_passed"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
              },
              "quiz": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
              }
            },
            "required": [
              "title",
              "path"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "slug",
        "level",
        "order",
        "title",
        "summary",
        "status",
        "estimated_minutes",
        "required",
        "requirements"
      ]
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "short_title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "preview",
            "published",
            "retired"
          ]
        },
        "language": {
          "const": "en"
        },
        "doris_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "theme": {
              "enum": [
                "blue",
                "purple",
                "green",
                "orange"
              ]
            },
            "badge_label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "theme",
            "badge_label"
          ]
        },
        "lab_setup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python_version": {
              "enum": [
                "3.10",
                "3.11",
                "3.12",
                "3.13"
              ]
            },
            "requirements": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
            },
            "supported_platforms": {
              "type": "array",
              "items": {
                "enum": [
                  "macos",
                  "linux",
                  "wsl2"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "guide": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "python_version",
            "requirements",
            "supported_platforms",
            "guide",
            "dependencies"
          ]
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "strategy": {
              "const": "all_required_modules"
            },
            "quiz_credit_policy": {
              "const": "preserve_passed"
            }
          },
          "required": [
            "enabled",
            "strategy",
            "quiz_credit_policy"
          ]
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z0-9]{2,24}$"
            },
            "template": {
              "const": "course_completion"
            }
          },
          "required": [
            "enabled",
            "code",
            "template"
          ]
        },
        "levels": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[1-9][0-9]*$": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/module"
          },
          "minItems": 1
        }
      },
      "required": [
        "slug",
        "title",
        "short_title",
        "description",
        "status",
        "language",
        "doris_version",
        "estimated_minutes",
        "presentation",
        "lab_setup",
        "completion",
        "certificate",
        "levels",
        "modules"
      ]
    },
    "quiz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "passing_score_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
              },
              "type": {
                "const": "single_choice"
              },
              "objective": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ]
                },
                "minItems": 2
              },
              "answer": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "objective",
              "prompt",
              "options",
              "answer",
              "explanation"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "description",
        "passing_score_percent",
        "questions"
      ]
    }
  }
}
