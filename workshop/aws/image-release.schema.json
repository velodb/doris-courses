{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated private workshop image release",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "doris-workshop-image-release"
    },
    "status": {
      "const": "validated"
    },
    "release_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "aws_account_id": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "region": {
      "type": "string"
    },
    "ami_id": {
      "type": "string",
      "pattern": "^ami-[0-9a-f]{17}$"
    },
    "architecture": {
      "const": "x86_64"
    },
    "course_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "deployment_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "course_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root_gib": {
      "type": "integer",
      "minimum": 20
    },
    "snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^snap-[0-9a-f]{17}$"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^i-[0-9a-f]{17}$"
        },
        "checked_at": {
          "type": "string"
        },
        "initial_audit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "course_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "browser_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cleanup_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "instance_id",
        "checked_at",
        "initial_audit_sha256",
        "course_report_sha256",
        "browser_report_sha256",
        "cleanup_sha256"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "status",
    "release_ref",
    "aws_account_id",
    "region",
    "ami_id",
    "architecture",
    "course_ref",
    "deployment_ref",
    "course_profiles",
    "runtime_sha256",
    "image_manifest_sha256",
    "root_gib",
    "snapshot_ids",
    "validation"
  ]
}
