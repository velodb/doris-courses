{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated private workshop image release",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "doris-workshop-image-release"
    },
    "status": {
      "const": "validated"
    },
    "release_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "aws_account_id": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "region": {
      "type": "string"
    },
    "ami_id": {
      "type": "string",
      "pattern": "^ami-[0-9a-f]{17}$"
    },
    "architecture": {
      "const": "x86_64"
    },
    "course_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "deployment_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "course_profiles": {
      "const": [
        "rta-module-1"
      ]
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root_gib": {
      "type": "integer",
      "minimum": 20
    },
    "snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^snap-[0-9a-f]{17}$"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^i-[0-9a-f]{17}$"
        },
        "checked_at": {
          "type": "string"
        },
        "initial_audit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "course_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "browser_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cleanup_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "instance_id",
        "checked_at",
        "initial_audit_sha256",
        "course_report_sha256",
        "browser_report_sha256",
        "cleanup_sha256"
      ]
    },
    "content": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "abi": {
          "const": "doris-workshop-content-2.1"
        },
        "capabilities": {
          "const": [
            "content-v2",
            "notebook-copies-v1",
            "quiz-presentations-v2"
          ]
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "available_locales": {
          "const": [
            "en",
            "kk-Cyrl"
          ]
        },
        "default_locale": {
          "enum": [
            "en",
            "kk-Cyrl"
          ]
        },
        "locale_digests": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kk-Cyrl": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "en",
            "kk-Cyrl"
          ],
          "additionalProperties": false
        },
        "profiles": {
          "const": [
            "rta-module-1"
          ]
        },
        "package_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependency_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "abi",
        "capabilities",
        "source_ref",
        "available_locales",
        "default_locale",
        "locale_digests",
        "profiles",
        "package_digest",
        "code_digest",
        "dependency_digest"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "status",
    "release_ref",
    "aws_account_id",
    "region",
    "ami_id",
    "architecture",
    "course_ref",
    "deployment_ref",
    "course_profiles",
    "runtime_sha256",
    "image_manifest_sha256",
    "root_gib",
    "snapshot_ids",
    "validation",
    "content"
  ]
}
